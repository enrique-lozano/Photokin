{
  "name": "photokin",
  "private": true,
  "license": "AGPL-3.0-only",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "predev": "node scripts/download_ffmpeg_sidecar.mjs && node scripts/setup_face_recognition_sidecar.mjs && node scripts/setup_clip_sidecar.mjs",
    "dev": "pnpm --dir src-vite dev",
    "dev:demo": "node scripts/dev-profile.mjs",
    "prebuild": "node scripts/download_ffmpeg_sidecar.mjs && node scripts/setup_face_recognition_sidecar.mjs && node scripts/setup_clip_sidecar.mjs",
    "build": "pnpm --dir src-vite build",
    "typecheck": "pnpm --dir src-vite typecheck",
    "preview": "pnpm --dir src-vite preview",
    "tauri": "tauri",
    "test": "pnpm --dir src-vite test",
    "lint": "eslint --config src-vite/eslint.config.js .",
    "lint:fix": "eslint --config src-vite/eslint.config.js . --fix",
    "prettier": "prettier --write \"src-vite/src/**/*{json,js,ts,tsx,jsx}\"",
    "prettier:check": "prettier --check \"src-vite/src/**/*{json,js,ts,tsx,jsx}\"",
    "screenshots": "node scripts/screenshots/screenshots.mjs",
    "website:dev": "vitepress dev website",
    "website:build": "vitepress build website",
    "website:preview": "vitepress preview website",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@commitlint/types": "^21.2.3",
    "@eslint/js": "^9.21.0",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/lora": "^5.2.8",
    "@tauri-apps/cli": "^2",
    "eslint": "^9.21.0",
    "eslint-plugin-react": "^7.37.4",
    "globals": "^16.0.0",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "playwright-core": "^1.64.1",
    "prettier": "^3.5.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitepress": "^1.6.4"
  }
}
