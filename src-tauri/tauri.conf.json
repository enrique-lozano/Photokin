{
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420"
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "externalBin": [
      "resources/ffmpeg/ffmpeg",
      "resources/ffmpeg/ffprobe",
      "resources/face_recognition/face_recognition",
      "resources/clip/clip"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "productName": "Photokin",
  "mainBinaryName": "photokin",
  "version": "../package.json",
  "identifier": "com.photokin.app",
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDYyODVBNzg5NEMyREQzNTIKUldSUzB5MU1pYWVGWWtoc25CYkFzN3ZOYldDQmNJRXhmcXI0VWw3Q1BQaU10V0tHeXpHNFJhUUYK",
      "endpoints": ["https://github.com/enrique-lozano/Photokin/releases/latest/download/latest.json"]
    }
  },
  "app": {
    "security": {
      "assetProtocol": {
        "scope": ["**"],
        "enable": true
      },
      "csp": "default-src 'self'; img-src 'self' data: blob: asset: http://asset.localhost https://asset.localhost https://tile.openstreetmap.org https://server.arcgisonline.com; media-src 'self' blob: asset: http://asset.localhost https://asset.localhost; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost https://ipc.localhost asset: http://asset.localhost https://asset.localhost; object-src 'none'",
      "devCsp": null,
      "dangerousDisableAssetCspModification": ["style-src"]
    },
    "windows": [
      {
        "title": "Photokin",
        "width": 920,
        "height": 620,
        "minWidth": 920,
        "minHeight": 620,
        "decorations": false,
        "dragDropEnabled": false,
        "useHttpsScheme": true
      }
    ]
  }
}
